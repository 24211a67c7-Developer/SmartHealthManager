# Rename this file to .env and fill in your real values

# Your MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/healthcare_db?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Any long random string - used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_secret_key

# Port the backend server runs on
PORT=5000
